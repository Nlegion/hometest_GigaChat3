FROM nvidia/cuda:12.1.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y \
    software-properties-common \
    git \
    cmake \
    curl \
    libcurl4-openssl-dev \
    && add-apt-repository ppa:deadsnakes/ppa -y \
    && apt-get update && apt-get install -y \
    python3.12 \
    python3.12-dev \
    wget \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Настройка переменных окружения для CUDA
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${CUDA_HOME}/lib64/stubs:${LD_LIBRARY_PATH}

# Сборка llama.cpp сервера
# Разделяем на отдельные RUN для лучшего кэширования
WORKDIR /tmp
RUN git clone --depth 1 https://github.com/ggml-org/llama.cpp.git

WORKDIR /tmp/llama.cpp
RUN cmake -B build \
        -DGGML_CUDA=ON \
        -DCUDA_TOOLKIT_ROOT_DIR=${CUDA_HOME} \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_EXE_LINKER_FLAGS="-Wl,-rpath,${CUDA_HOME}/lib64"

# Ограничиваем параллелизм для стабильности (используем 4 потока вместо всех ядер)
RUN cmake --build build --config Release --target llama-server -j 4 && \
    mv build/bin/llama-server /usr/local/bin/llama-server

WORKDIR /
RUN rm -rf /tmp/llama.cpp

WORKDIR /app

COPY requirements.txt .
RUN wget https://bootstrap.pypa.io/get-pip.py && \
    python3.12 get-pip.py && \
    rm get-pip.py && \
    pip3.12 install --no-cache-dir --upgrade pip && \
    pip3.12 install --no-cache-dir -r requirements.txt

COPY app/ ./app/
COPY static/ ./static/
COPY templates/ ./templates/

COPY data/model/ ./data/model/

EXPOSE 8000

CMD ["python3.12", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
